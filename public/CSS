body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    color: #222;
}

.about-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 100px 30px;
}

/* Header */

.about-header {
    max-width: 800px;
    margin-bottom: 70px;
}

.eyebrow {
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 3px;
    color: #666;
    margin-bottom: 15px;
}

.about-header h1 {
    font-size: 60px;
    margin: 0 0 25px;
    line-height: 1.1;
}

.intro {
    font-size: 24px;
    line-height: 1.5;
    color: #555;
}

/* Content */

.about-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 70px;
    align-items: start;
}

.about-text p {
    font-size: 18px;
    line-height: 1.8;
    color: #555;
    margin-bottom: 30px;
}

/* Skills card */

.skills-card {
    background-color: white;
    padding: 35px;
    border-radius: 15px;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
}

.skills-card h2 {
    margin-top: 0;
    margin-bottom: 25px;
    font-size: 24px;
}

.tools {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.tools span {
    background-color: #f0f0f0;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 14px;
}

/* Mobile */

@media (max-width: 768px) {

    .about-section {
        padding: 60px 20px;
    }

    .about-header h1 {
        font-size: 42px;
    }

    .intro {
        font-size: 20px;
    }

    .about-content {
        grid-template-columns: 1fr;
        gap: 40px;
    }

}
