body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    color: #222;
}

.clients-section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px 30px;
}

.clients-section h1 {
    font-size: 48px;
    margin-bottom: 30px;
}

.clients-section img {
    width: 100%;
    max-height: 350px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 50px;
}

.clients-section h2 {
    font-size: 30px;
    margin-bottom: 15px;
}

.clients-section p {
    max-width: 700px;
    font-size: 18px;
    line-height: 1.7;
    color: #555;
    margin-bottom: 40px;
}

.clients-section ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
}

.clients-section li {
    background-color: white;
    padding: 25px;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.clients-section li:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}
